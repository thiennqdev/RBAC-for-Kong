# ==========================================
# Backend & Infrastructure Environment Variables
# ==========================================

# Database Configuration
POSTGRES_DB=rbac_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Keycloak SSO
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_REALM=rbac-management
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# MinIO / S3 Object Storage
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=devops-platform

# Kafka / Live Logs
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Master Key for Sensitive Field Encryption (32 bytes AES)
MASTER_KEY=my-secure-master-key-32-bytes-ok

# Email Notification (Gmail SMTP)
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-google-app-password
MAIL_FROM=your-email@example.com
